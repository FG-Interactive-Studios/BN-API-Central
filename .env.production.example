# Battleship API - exemplo de ambiente de PRODUCAO.
# Copie para .env.production fora do Git e substitua todos os valores de exemplo.
# Nunca versionar este arquivo depois de preenchido.

# Ativa explicitamente o perfil de producao (sem chave JWT automatica).
SPRING_PROFILES_ACTIVE=prod

# Porta HTTP da API dentro do processo/container.
PORT=8080

# PostgreSQL acessivel a partir do processo/container da API.
# Substitua o hostname; "localhost" dentro de um container aponta para ele mesmo.
# Se a conexao cruzar uma rede nao confiavel, configure TLS adequadamente.
DB_URL=jdbc:postgresql://SEU_HOST_POSTGRES:5432/battleship
DB_USER=SEU_USUARIO_POSTGRES
DB_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE

# Chave JWT HS256 persistente e compartilhada entre instancias.
# Gere UMA VEZ, armazene em cofre de segredos e nao imprima em logs:
#   openssl rand -base64 48
# Nunca reutilize a chave de testes/CI; trocar esta chave invalida os access tokens.
AUTH_JWT_SECRET_B64=COLE_A_CHAVE_BASE64_GERADA_AQUI
